{
  "name": "stellar-tip-jar",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm i -g @anthropic-ai/claude-code && npm ci --ignore-scripts",
  "secrets": {
    "CLAUDE_CODE_OAUTH_TOKEN": {
      "description": "Long-lived token from `claude setup-token` (claude.ai login, no API key)"
    }
  }
}
